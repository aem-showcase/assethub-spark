#!/usr/bin/env sh

# Only run on new worktree creation (prev ref is all zeros)
if [ "$1" = "0000000000000000000000000000000000000000" ]; then
  # Find the main worktree root (where .git is a directory, not a file)
  main_root="$(git rev-parse --path-format=absolute --git-common-dir)"
  main_root="${main_root%/.git}"

  # Copy secret/config files as REAL files, never symlink — each worktree must
  # own independent secrets so parallel demos never share or clobber a token
  # (rebrand-portal I10). Symlinking re-shares one token across worktrees.
  [ -f "$main_root/cloudflare/.secrets" ] && cp "$main_root/cloudflare/.secrets" "$(pwd)/cloudflare/.secrets"
  [ -f "$main_root/token.env" ] && cp "$main_root/token.env" "$(pwd)/token.env"

  # Install dependencies
  echo "post-checkout: installing dependencies..."
  npm install
fi
