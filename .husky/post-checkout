#!/usr/bin/env sh

# Fallback for worktrees created outside Claude Code (plain `git worktree add`,
# other tools): copy the secret/config files each worktree needs its own
# independent copy of (rebrand-portal I9). `claude -w` does the same via
# .claude/hooks/worktree-create.js; both are idempotent, so it is safe for both
# to run on the same worktree.
#
# Dependencies are not installed here; run.sh (npm start) does that lazily.

# Only run on new worktree creation (prev ref is all zeros)
if [ "$1" != "0000000000000000000000000000000000000000" ]; then
  exit 0
fi

# Main checkout root = parent of the shared git dir
main_root="$(git rev-parse --path-format=absolute --git-common-dir)"
main_root="$(dirname "${main_root%/}")"
worktree_root="$(pwd)"

# Copy secret/config files as REAL files, never symlink — each worktree must
# own independent secrets so parallel demos never share or clobber a token
# (rebrand-portal I9). Symlinking re-shares one token across worktrees.
[ -f "$main_root/cloudflare/.secrets" ] && cp "$main_root/cloudflare/.secrets" "$worktree_root/cloudflare/.secrets"
[ -f "$main_root/token.env" ] && cp "$main_root/token.env" "$worktree_root/token.env"
