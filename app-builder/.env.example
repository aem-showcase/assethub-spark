# App Builder PoC — environment template. Copy to .env and fill in.
# .env is git-ignored (repo root .gitignore covers `.env`). Never commit real values.

# --- Adobe I/O Runtime namespace (from the Developer Console workspace JSON) ---
AIO_runtime_namespace=<ims-org>-<project>-<workspace>
AIO_runtime_auth=<auth-uuid>:<auth-secret>
AIO_runtime_apihost=https://adobeioruntime.net

# --- App config (non-secret) ---
# EDS origin the dispatcher proxies. Use the PREVIEW host (.aem.page) to serve the
# LATEST DA-authored content (e.g. the "Featured Smart Collections" home section
# that isn't published to .aem.live yet). This mirrors the Worker's preview-origin
# behaviour (cloudflare/src/index.js withPreviewOrigin swaps .aem.live -> .aem.page
# for the preview host). Switch to .aem.live to proxy published content instead.
HELIX_ORIGIN=https://main--assethub-spark--aem-showcase.aem.page

# Path A — the URL prefix the deployed dispatcher action lives under. When set,
# served HTML + redirects are rewritten to stay under this prefix, so the site
# self-hosts on the raw adobeioruntime.net URL WITHOUT a custom domain. Leave
# EMPTY to serve at the domain root (requires a custom domain/CDN in front).
# For the default Stage deployment this is /api/v1/web/<package>/<action>.
BASE_PATH=/api/v1/web/spark/dispatcher

# --- Secrets (reused from the Cloudflare deployment) ---
COOKIE_SECRET=
HELIX_ORIGIN_AUTHENTICATION=
DM_CLIENT_ID=
DM_CLIENT_SECRET=

# --- Cloudflare D1 over HTTP (keep existing DB; no migration) ---
# Account + DB IDs come from cloudflare/wrangler.jsonc. Token needs D1:Edit.
# NOTE: PoC uses a personal (user) API token — swap for an account-owned token
# before any shared/production use.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=
