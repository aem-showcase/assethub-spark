{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/rebrand-portal/hooks/guard-da-publish.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/rebrand-portal/hooks/guard-auth-bypass-commit.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/rebrand-portal/hooks/guard-secret-read.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/rebrand-portal/hooks/guard-step5-verify-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/rebrand-portal/hooks/guard-brand-extraction.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/rebrand-portal/hooks/guard-live-publish-ceiling.sh"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/mohitar/.local/bin/scout\" hook subagent"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/mohitar/.local/bin/scout\" hook bash-compress || echo {}"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/mohitar/.local/bin/scout\" hook session --host claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/mohitar/.local/bin/scout\" hook reflect"
          }
        ]
      }
    ]
  }
}
