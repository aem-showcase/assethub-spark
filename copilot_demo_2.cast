[2.507, "o", "\u001b[?25l\u001b[4;58r\u001b[58;1H\r\n\r\n\r\n\r\n\r\n\u001b[1;62r\u001b[53;1H\u001b[36m┃\u001b[m ❯ /add-dir                            Allow file access to a directory and load its .github skills and agents as trusted configuration\u001b[K\r\n┃   /agent\u001b[54;41HBrowse and select agents: /agent [name]\r\n┃   /allow-all\u001b[55;41HEnable all permissions (tools, paths, and URLs)\r\n┃   /app\u001b[56;41HPrefer a visual workspace? Try out the GitHub Copilot desktop app\r\n┃   /ask\u001b[57;41HAsk a quick side question without adding to conversation history\r\n┃   /autopilot\u001b[58;41HToggle autopilot mode, or set an autopilot objective with an optional AI-credit limit (--max-ai-credits)\r\n\r\n\u001b[2C/add-dir\r\n\r\n \u001b[35mautopilot\u001b[m                                             \u001b[60;4H\u001b[?25h"]
[0.289, "o", "\u001b[?25l\u001b[7A /\u001b[4me\u001b[mnv    \u001b[53;41HShow loaded environment details (instructions, MCP servers, skills, agents, hooks, plugins, LSPs, extensions)\r\n\u001b[5C\u001b[4me\u001b[mxit \u001b[54;41HExit the CLI; use 'print' to print the session after exiting alt screen\r\n\u001b[5C\u001b[4me\u001b[mxperimental\u001b[55;41HShow available experimental features, or enable/disable experimental mode\r\n\u001b[5C\u001b[4me\u001b[mxport\u001b[56;41HShare session or research report to a markdown file, HTML file, GitHub gist, or a shareable GitHub link\r\n\u001b[5C\u001b[4me\u001b[mxcat:block-mapping-manager\u001b[57;41HManages block mappings in page-templates.json. Adds DOM selectors for block variants after page analysis. Skips pages already mapped (URL deduplication).\r\n\u001b[5C\u001b[4me\u001b[mxcat:block-variant-manager\u001b[58;41HManages block variant lifecycle for multi-page migrations including enriched catalog loading, similarity matching, metadata.json management, and variant creation. Scans existing variants, performs intelli…\r\r\n\r\n\u001b[3Cenv\u001b[K\b\b\u001b[?25h"]
