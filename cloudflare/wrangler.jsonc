{
  // configure worker name and Cloudflare account
  "name": "spark-eds",
  "account_id": "5950b56d4c83856bae7035a7b9e7ce99",
  "main": "src/index.js",
  "compatibility_date": "2025-08-16",

  "workers_dev": false,

  // ====================================================================
  // Bindings only. Static, non-varying config values live in src/config.js
  // (single source of truth). Only bindings, secrets, and per-deploy
  // values (HELIX_ORIGIN / name / route, injected via CLI flags) belong here.
  // ====================================================================

  // Top-level bindings used by `wrangler dev` (no --env) and the local
  // schema-setup script. Named env blocks below do NOT inherit these —
  // each env must re-declare the bindings it needs.
  "d1_databases": [
    // BUG: all three bindings point at the same database_id (3db42334-...).
    // Three logical DBs sharing one physical DB will cross-contaminate tables.
    // Preserved verbatim from the previous wrangler.toml; fix separately.
    { "binding": "USER_LOGINS", "database_name": "spark-user-logins", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" },
    { "binding": "AUDIT_EVENTS", "database_name": "spark-audit-events", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" },
    { "binding": "SEARCH_EVENTS", "database_name": "spark-search-events", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" }
  ],

  "observability": {
    "logs": {
      "enabled": true
    }
  },

  // ====================================================================
  // environment for production (main branch)
  // ====================================================================
  "env": {
    "production": {
      "name": "spark-eds-production",

      "routes": [
        { "pattern": "spark.aem.media/*", "zone_name": "spark.aem.media" }
      ],

      "kv_namespaces": [
        { "binding": "AUTH_TOKENS", "id": "36672f6acf244f80855367c1322110d5" },
        // TODO: real KV namespace id from Cloudflare dashboard. Used by /api/messages
        // (src/api/notifications.js) — that route 500s until this is filled.
        { "binding": "MESSAGES", "id": "REPLACE_ME_messages_kv_id" }
      ],

      "secrets_store_secrets": [
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "COOKIE_SECRET", "secret_name": "SPARK_COOKIE_SECRET" },
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "HELIX_ORIGIN_AUTHENTICATION", "secret_name": "SPARK_HELIX_ORIGIN_AUTHENTICATION" },
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "DM_CLIENT_ID", "secret_name": "SPARK_DM_CLIENT_ID" },
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "DM_CLIENT_SECRET", "secret_name": "SPARK_DM_CLIENT_SECRET" },
        // TODO: provision this secret value in .secrets and the Cloudflare Secret Store.
        // Used by the analytics API (src/api/analytics.js) via .get(); guarded (graceful 500 if absent).
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "ANALYTICS_API_TOKEN", "secret_name": "SPARK_ANALYTICS_API_TOKEN" }
      ],

      // BUG: shared database_id — see note at top-level d1_databases.
      "d1_databases": [
        { "binding": "USER_LOGINS", "database_name": "spark-user-logins", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" },
        { "binding": "AUDIT_EVENTS", "database_name": "spark-audit-events", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" },
        { "binding": "SEARCH_EVENTS", "database_name": "spark-search-events", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" }
      ],

      // TODO: real dataset name from Cloudflare dashboard. Used by src/util/analytics-helper.js
      // (guarded — analytics writes are skipped when absent).
      "analytics_engine_datasets": [
        { "binding": "SPARK_ANALYTICS_ENGINE", "dataset": "REPLACE_ME_analytics_dataset" }
      ]
    },

    // ==================================================================
    // environment used for PRs/branches and local dev server.
    // name / route / HELIX_ORIGIN are injected via CLI flags in build.yaml.
    // ==================================================================
    "branch": {
      "kv_namespaces": [
        { "binding": "AUTH_TOKENS", "id": "36672f6acf244f80855367c1322110d5" },
        // TODO: real KV namespace id (see production note above).
        { "binding": "MESSAGES", "id": "REPLACE_ME_messages_kv_id" }
      ],

      "secrets_store_secrets": [
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "COOKIE_SECRET", "secret_name": "SPARK_COOKIE_SECRET" },
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "HELIX_ORIGIN_AUTHENTICATION", "secret_name": "SPARK_HELIX_ORIGIN_AUTHENTICATION" },
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "DM_CLIENT_ID", "secret_name": "SPARK_DM_CLIENT_ID" },
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "DM_CLIENT_SECRET", "secret_name": "SPARK_DM_CLIENT_SECRET" },
        // TODO: provision this secret value (see production note above).
        { "store_id": "a6f677643a894c5c99d08a280e61e605", "binding": "ANALYTICS_API_TOKEN", "secret_name": "SPARK_ANALYTICS_API_TOKEN" }
      ],

      "d1_databases": [
        { "binding": "USER_LOGINS", "database_name": "spark-user-logins", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" },
        { "binding": "AUDIT_EVENTS", "database_name": "spark-audit-events", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" },
        { "binding": "SEARCH_EVENTS", "database_name": "spark-search-events", "database_id": "3db42334-a8ba-48cc-b5bd-84f7e1b04eb2" }
      ],

      // TODO: real dataset name (see production note above).
      "analytics_engine_datasets": [
        { "binding": "SPARK_ANALYTICS_ENGINE", "dataset": "REPLACE_ME_analytics_dataset" }
      ]
    }
  }
}
